[Unit]
Description=Baromio Private Probe
After=network-online.target
Wants=network-online.target

[Service]
# DynamicUser creates an ephemeral, unprivileged user for this unit only -
# no shared "probe" account, no UID to manage.
DynamicUser=yes
StateDirectory=baromio-probe
Environment=BAROMIO_DATA_DIR=/var/lib/baromio-probe
# BAROMIO_ENROLL_TOKEN is only needed once, on first start before
# /var/lib/baromio-probe/identity.json exists - set it in an override for
# that first run, then remove it.
EnvironmentFile=-/etc/baromio-probe/env
ExecStart=/usr/local/bin/baromio-probe
Restart=on-failure
RestartSec=5s

# Hard memory cap. The Probe idles around 6 MB with 18 monitors; 150M leaves
# plenty of headroom. MemorySwapMax=0 makes an overrun an OOM kill (restarted
# after RestartSec) instead of slow swapping on a small host.
MemoryMax=150M
MemorySwapMax=0

ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
ProtectProc=invisible
ProcSubset=pid
ProtectClock=yes
ProtectHostname=yes
RemoveIPC=yes
UMask=0077
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
